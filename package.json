{
  "name": "@hardbrick21/x-txid-generator",
  "version": "1.0.1",
  "description": "X/Twitter x-client-transaction-id generator for Node.js",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "keywords": ["x", "twitter", "x-client-transaction-id", "transaction-id"],
  "license": "MIT",
  "dependencies": {
    "cheerio": "1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.9.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
